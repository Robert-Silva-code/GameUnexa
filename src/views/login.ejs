<%- include('partials/head', { title: 'Entrar' }) %>

<div class="auth-wrapper">
  <h1>Bem-vindo de volta</h1>
  <p class="auth-subtitle">Entre na sua conta para acessar sua biblioteca.</p>

  <% if (error) { %>
    <div class="alert-error"><%= error %></div>
  <% } %>

  <form action="/auth/login" method="POST">
    <div class="form-group">
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" required>
    </div>

    <div class="form-group">
      <label for="password">Senha</label>
      <input type="password" id="password" name="password" required>
    </div>

    <button type="submit" class="btn btn-primary btn-full">Entrar</button>
  </form>

  <p style="margin-top: 16px; font-size: 0.9rem; color: var(--text-secondary);">
    Ainda não tem conta? <a href="/auth/register" style="color: var(--accent-green);">Cadastre-se</a>
  </p>
</div>

<%- include('partials/footer') %>