<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | GameUnexa' : 'GameUnexa' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<body>
  <header class="navbar">
    <a href="/" class="nav-brand">Game<span>Unexa</span></a>

    <nav class="nav-links">
      <% if (locals.user) { %>
        <a href="/feed"><i class="ph ph-chat"></i>  Feed</a>
        <a href="/games/catalog"><i class="ph ph-list-dashes"></i> Catálogo</a>
        <a href="/profile"><i class="ph ph-user"></i> Perfil</a>
        <a href="/community"><i class="ph ph-users-four"></i> Comunidade</a>
        <a href="/messages"><i class="ph ph-chats"></i> Mensagens</a>
        <span class="nav-user-badge">@<%= user.username %></span>
        <a href="/auth/logout" class="btn btn-danger">Sair</a>
      <% } else { %>
        <a href="/auth/login">Entrar</a>
        <a href="/auth/register" class="btn btn-primary">Criar Conta</a>
      <% } %>
    </nav>
  </header>

  <main class="container">