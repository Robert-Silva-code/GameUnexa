<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | GameUnexa' : 'GameUnexa' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="navbar">
    <a href="/" class="nav-brand">Game<span>Unexa</span></a>

    <nav class="nav-links">
      <% if (locals.user) { %>
        <a href="/games/catalog">Catálogo</a>
        <a href="/profile">Minha Biblioteca</a>
        <a href="/community">Comunidade</a>
        <span class="nav-user-badge">@<%= user.username %></span>
        <a href="/auth/logout" class="btn btn-danger">Sair</a>
      <% } else { %>
        <a href="/auth/login">Entrar</a>
        <a href="/auth/register" class="btn btn-primary">Criar Conta</a>
      <% } %>
    </nav>
  </header>

  <main class="container">