<section class="interaction-panel" data-interaction-target="<%= targetType %>" data-target-id="<%= targetId %>"
         data-viewer-id="<%= currentUser?.id || '' %>" aria-label="Curtidas e comentários">
  <% if (targetType === "post") { %>
    <% if (currentUser) { %>
      <button class="like-button" type="button" data-like-button aria-pressed="false">
        <span aria-hidden="true">♥</span> <span data-like-label>Curtir</span>
        <span class="like-count" data-like-count>0</span>
      </button>
    <% } else { %>
      <a class="like-button like-login" href="/login">♥ <span data-like-count>0</span> curtidas</a>
    <% } %>
  <% } %>
  <div class="comment-section">
    <h3>Comentários <span class="review-count" data-comment-count>Carregando…</span></h3>
    <div class="comment-list" data-comment-list aria-live="polite">
      <p class="muted" data-interaction-status>Carregando interações…</p>
    </div>
    <% if (currentUser) { %>
      <form class="comment-form" data-comment-form>
        <label class="sr-only" for="comment-<%= targetType %>-<%= targetId %>">Escreva um comentário</label>
        <textarea id="comment-<%= targetType %>-<%= targetId %>" name="content" rows="2"
                  maxlength="2000" placeholder="Escreva um comentário…" required></textarea>
        <button class="secondary-button" type="submit">Comentar</button>
      </form>
    <% } else { %>
      <p class="muted"><a href="/login">Entre na sua conta</a> para comentar.</p>
    <% } %>
  </div>
</section>
