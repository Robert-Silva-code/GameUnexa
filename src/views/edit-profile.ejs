<%- include('partials/head', { title: 'Editar Perfil' }) %>

<div class="auth-wrapper" style="max-width: 520px;">
  <h1>Editar Perfil</h1>
  <p class="auth-subtitle">Personalize como os outros jogadores veem @<%= userData.username %>.</p>

  <% if (error) { %>
    <div class="alert-error"><%= error %></div>
  <% } %>

  <form action="/user/edit" method="POST">
    <div class="form-group">
      <label for="avatarUrl">URL da Foto de Perfil</label>
      <input
        type="text"
        id="avatarUrl"
        name="avatarUrl"
        placeholder="https://exemplo.com/minha-foto.jpg"
        value="<%= userData.avatarUrl %>"
      >
      <small style="color: var(--text-muted); font-size: 0.8rem;">
        Deixe em branco para usar um avatar automático com seu nickname.
      </small>
    </div>

    <div class="form-group">
      <label for="favoritePlatform">Plataforma Preferida</label>
      <select id="favoritePlatform" name="favoritePlatform">
        <option value="" <%= !userData.favoritePlatform ? 'selected' : '' %>>Não informada</option>
        <option value="PC" <%= userData.favoritePlatform === 'PC' ? 'selected' : '' %>>PC</option>
        <option value="PlayStation" <%= userData.favoritePlatform === 'PlayStation' ? 'selected' : '' %>>PlayStation</option>
        <option value="XBOX" <%= userData.favoritePlatform === 'XBOX' ? 'selected' : '' %>>Xbox</option>
        <option value="Nintendo" <%= userData.favoritePlatform === 'Nintendo' ? 'selected' : '' %>>Nintendo</option>
        <option value="Outros" <%= userData.favoritePlatform === 'Outros' ? 'selected' : '' %>>Outros</option>
      </select>
    </div>

    <div class="form-group">
      <label for="bio">Biografia</label>
      <textarea
        id="bio"
        name="bio"
        rows="4"
        maxlength="240"
        placeholder="Conte um pouco sobre seus gêneros favoritos, jogos marcantes ou ID da Steam/PSN..."
        style="width: 100%; padding: 10px 12px; background-color: var(--bg-input); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); color: var(--text-primary); font-family: inherit; font-size: 0.95rem; resize: vertical;"
      ><%= userData.bio %></textarea>
    </div>

    <div style="display: flex; gap: 10px; margin-top: 20px;">
      <a href="/profile" class="btn btn-secondary" style="flex: 1;">Cancelar</a>
      <button type="submit" class="btn btn-primary" style="flex: 2;">Salvar Alterações</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>